      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "matches",
      "row": 21,
      "col": 1,
      "title": "Is the evidence sufficient?",
      "role": "policy",
      "summary": "Check relevance, ambiguity and conflict.",
      "detail": "Do not turn the nearest match into an unsupported answer.",
      "phase": "",
      "decision": true,
      "reference": "full-architecture"
    },
    {
      "id": "clarify",
      "row": 21,
      "col": 0,
      "title": "Hold or ask for clarity",
      "role": "human",
      "summary": "No match or unclear question.",
