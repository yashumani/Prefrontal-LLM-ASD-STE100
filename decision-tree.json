      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "route",
      "row": 20,
      "col": 1,
      "title": "Which discovery path?",
      "role": "agent",
      "summary": "Code selects the permitted method.",
