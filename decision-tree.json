      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "conflict",
      "row": 21,
      "col": 2,
      "title": "Review conflicting meaning",
      "role": "human",
      "summary": "The owner resolves conflicting evidence.",
      "detail": "Any new interpretation returns to a governed submission.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "resolve",
      "row": 22,
      "col": 1,
      "title": "Resolve canonical records",
      "role": "agent",
      "summary": "Load current approved state.",
      "detail": "Treat index hits as candidates. Resolve their source IDs and versions before delivery.",
      "phase": "06 · DELIVERY",
      "decision": false,
      "reference": "full-architecture"
    },
    {
