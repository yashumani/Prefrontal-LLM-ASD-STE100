{
  "title": "Every decision. One governed journey.",
  "status": "Proposed process · not a running backend",
  "description": "Follow a submission into approved context, then follow a separate consumer request through secure retrieval and delivery. Side branches show what happens when a check fails.",
  "nodes": [
    {
      "id": "submit",
      "row": 0,
      "col": 1,
      "title": "Submit context",
      "role": "human",
      "summary": "A person or agent submits evidence.",
      "detail": "Use a structured template with source, owner, workspace, meaning and conditions. Preserve the original.",
      "phase": "01 · SUBMISSION",
      "decision": false,
      "reference": "submission-template"
    },
    {
      "id": "sources",
      "row": 0,
      "col": 2,
      "title": "Sources and systems",
      "role": "source",
      "summary": "Documents, LookML and custom apps.",
      "detail": "Adapters preserve native source references and versions. Existing analytics systems remain authoritative for execution.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "admit",
      "row": 1,
      "col": 1,
      "title": "May we accept this source?",
      "role": "policy",
      "summary": "Check identity, workspace and source rights.",
      "detail": "Admission policy runs outside the model. An available connector is not permission.",
      "phase": "",
      "decision": true,
      "reference": "full-architecture"
    },
    {
      "id": "deny-intake",
      "row": 1,
      "col": 0,
      "title": "Deny admission",
      "role": "stop",
      "summary": "Do not ingest restricted content.",
      "detail": "Record a permitted audit receipt. A source owner must resolve access before another submission.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "prepare",
      "row": 2,
      "col": 1,
      "title": "Prepare a review record",
      "role": "agent",
      "summary": "Keep original text and an STE-inspired view.",
      "detail": "Extract structured fields. Preserve dates, units, negation, exceptions and uncertainty. This does not approve meaning.",
      "phase": "",
      "decision": false,
      "reference": "submission-template"
    },
    {
      "id": "complete",
      "row": 3,
      "col": 1,
      "title": "Is the record complete?",
      "role": "policy",
      "summary": "Schema, required fields and evidence.",
      "detail": "Reject malformed data. Do not invent missing evidence.",
      "phase": "",
      "decision": true,
      "reference": "full-architecture"
    },
    {
      "id": "repair",
      "row": 3,
      "col": 0,
      "title": "Return for correction",
      "role": "human",
      "summary": "The submitter repairs the record.",
      "detail": "The same preparation checks run again after correction.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "meaning",
      "row": 4,
      "col": 1,
      "title": "Does the meaning match?",
      "role": "policy",
      "summary": "Compare the clear view with the source.",
      "detail": "Hold unsupported or conflicting claims. Shorter English must not remove an exception or change a formula.",
      "phase": "",
      "decision": true,
      "reference": "meaning-preserving-ste"
    },
    {
      "id": "hold-meaning",
      "row": 4,
      "col": 0,
      "title": "Resolve the meaning",
      "role": "human",
      "summary": "A responsible reviewer resolves the gap.",
      "detail": "Uncertainty stays explicit. Submit a corrected draft for preparation and review.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "review",
      "row": 5,
      "col": 1,
      "title": "Does the human approve?",
      "role": "human",
      "summary": "Approve this exact version and evidence.",
      "detail": "The reviewer can approve, request revision or reject. Model scores never replace this authority.",
      "phase": "02 · GOVERNANCE",
      "decision": true,
      "reference": "human-review-routes"
    },
    {
      "id": "revise",
      "row": 5,
      "col": 0,
      "title": "Request revision",
      "role": "human",
      "summary": "Return the draft with review notes.",
      "detail": "Any revised meaning requires review of the new exact version.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "reject",
      "row": 5,
      "col": 2,
      "title": "Reject the draft",
      "role": "stop",
      "summary": "Do not publish the rejected version.",
      "detail": "Preserve the review outcome and allowed audit history.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "identity",
      "row": 6,
      "col": 1,
      "title": "Does this identity exist?",
      "role": "policy",
      "summary": "Resolve the business object first.",
      "detail": "A canonical ID identifies one governed object. It grants no permission.",
      "phase": "",
      "decision": true,
      "reference": "context-contract"
    },
    {
      "id": "new-id",
      "row": 6,
      "col": 0,
      "title": "Allocate a new ID",
      "role": "record",
      "summary": "Create a unique canonical identity.",
      "detail": "Create only after identity resolution. Preserve source and ownership links.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "registry",
      "row": 7,
      "col": 1,
      "title": "Save the approved version",
      "role": "record",
      "summary": "ID, version, status and review history.",
      "detail": "Bind approval to exact content. For metrics, retain the LookML reference and Git revision, population, grain, unit and period.",
      "phase": "",
      "decision": false,
      "reference": "context-contract"
    },
    {
      "id": "harness",
      "row": 8,
      "col": 1,
      "title": "Run bounded orchestration",
      "role": "agent",
      "summary": "Code sets routes, budgets and limits.",
      "detail": "Use typed choice, yes/no or rubric signals only when helpful. Deterministic code can handle known rules.",
      "phase": "03 · ORGANIZATION",
      "decision": false,
      "reference": "bounded-decision-router"
    },
    {
      "id": "model",
      "row": 8,
      "col": 2,
      "title": "Optional decision model",
      "role": "agent",
      "summary": "Choice · yes/no · rubric score.",
      "detail": "A replaceable model provides signals and evidence references. Calibration and JEV parity are unverified. It cannot grant approval.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "signals",
      "row": 9,
      "col": 1,
      "title": "Are decisions valid?",
      "role": "policy",
      "summary": "Validate output shape and evidence.",
      "detail": "Code checks allowed values, evidence references, permissions and limits. Invalid signals stop the operation.",
      "phase": "",
      "decision": true,
      "reference": "full-architecture"
    },
    {
      "id": "invalid-signal",
      "row": 9,
      "col": 0,
      "title": "Stop invalid work",
      "role": "stop",
      "summary": "No permitted operation follows.",
      "detail": "Keep the failure visible. Correct the input or model response before another attempt.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "approved-only",
      "row": 10,
      "col": 1,
      "title": "Only approved meaning?",
      "role": "policy",
      "summary": "No new claims or unresolved conflicts.",
      "detail": "The agent may place approved records. New interpretation must return through preparation and exact-version review.",
      "phase": "",
      "decision": true,
      "reference": "full-architecture"
    },
    {
      "id": "new-meaning",
      "row": 10,
      "col": 0,
      "title": "Submit new meaning",
      "role": "human",
      "summary": "Human review remains required.",
      "detail": "A model explanation is a draft, not an approved fact.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "layers",
      "row": 11,
      "col": 1,
      "title": "Place linked context",
      "role": "context",
      "summary": "Data · Metric · Ontology · Interpretation.",
      "detail": "Data holds facts and units. Metric holds formula, grain and period. Ontology holds concepts and relationships. Interpretation holds meaning and assumptions. These categories do not require four databases.",
      "phase": "",
      "decision": false,
      "reference": "semantic-layers"
    },
    {
      "id": "dependencies",
      "row": 12,
      "col": 1,
      "title": "Are dependencies valid?",
      "role": "policy",
      "summary": "Check approved input IDs and versions.",
      "detail": "References, permissions, validity and lineage must support the full derived object.",
      "phase": "",
      "decision": true,
      "reference": "full-architecture"
    },
    {
      "id": "hold-dependencies",
      "row": 12,
      "col": 0,
      "title": "Hold publication",
      "role": "stop",
      "summary": "Repair missing or invalid references.",
      "detail": "Do not publish a derived object whose evidence or dependency is invalid. Resubmit changed meaning.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "publish",
      "row": 13,
      "col": 1,
      "title": "Prepare an atomic release",
      "role": "agent",
      "summary": "Publish a complete validated snapshot.",
      "detail": "Never expose a partial update. Retain traceable versions and release receipts.",
      "phase": "04 · PUBLICATION",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "release",
      "row": 14,
      "col": 1,
      "title": "Did publication succeed?",
      "role": "policy",
      "summary": "Check durable state and readback.",
      "detail": "A completed write request is not proof of a valid release.",
      "phase": "",
      "decision": true,
      "reference": "full-architecture"
    },
    {
      "id": "prior",
      "row": 14,
      "col": 0,
      "title": "Use valid prior release",
      "role": "record",
      "summary": "Only while it remains valid and permitted.",
      "detail": "If no valid prior release exists, hold delivery. Repair the publication fault and retry.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "index",
      "row": 15,
      "col": 1,
      "title": "Build derived search views",
      "role": "search",
      "summary": "Index approved release references.",
      "detail": "Index descriptions and linked evidence. Preserve IDs and versions. The canonical registry remains authoritative. Rebuild or invalidate when source state changes.",
      "phase": "",
      "decision": false,
      "reference": "layered-memory"
    },
    {
      "id": "request",
      "row": 16,
      "col": 1,
      "title": "Receive a context request",
      "role": "human",
      "summary": "A user asks a question or supplies an ID.",
      "detail": "Resolve caller, workspace, purpose and requested context. The request does not inherit the submitter’s permissions.",
      "phase": "05 · CONSUMPTION",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "app",
      "row": 16,
      "col": 2,
      "title": "Another user or app",
      "role": "consumer",
      "summary": "Analytics, assistants and workflows.",
