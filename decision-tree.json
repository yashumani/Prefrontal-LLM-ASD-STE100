      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "authenticated",
      "row": 17,
      "col": 1,
      "title": "Is the caller verified?",
      "role": "policy",
      "summary": "Authenticate the requesting identity.",
