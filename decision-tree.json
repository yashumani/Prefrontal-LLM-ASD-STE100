      "phase": "",
      "decision": true,
      "reference": "full-architecture"
    },
    {
      "id": "links",
      "row": 20,
      "col": 0,
      "title": "Follow approved links",
      "role": "context",
      "summary": "Find related people, metrics and concepts.",
      "detail": "Follow only approved relationships. Check access on every linked record.",
      "phase": "",
      "decision": false,
      "reference": "full-architecture"
    },
    {
      "id": "hybrid",
      "row": 20,
      "col": 2,
      "title": "Search words and meaning",
      "role": "search",
      "summary": "Combine keyword and semantic matches.",
