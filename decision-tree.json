      "phase": "",
      "decision": true,
      "reference": "full-architecture"
    },
    {
      "id": "lookup",
      "row": 19,
      "col": 0,
      "title": "Exact ID lookup",
      "role": "record",
      "summary": "Resolve the requested ID and version.",
